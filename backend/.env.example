# Local Docker MySQL (do not point this at production).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=psm_infinity
DB_USER=psm
DB_PASSWORD=psm_local_password

# Signed session cookie
AUTH_SECRET=replace-with-32-plus-random-characters

# Single owner account created/updated by db:migrate
ADMIN_EMAIL=sunandan@example.com
ADMIN_PASSWORD=change-me

# Comma-separated frontend origins allowed to call /api/v1
ALLOWED_ORIGINS=http://localhost:3000

# Public absolute URL of this backend (media links, password-reset emails)
BACKEND_PUBLIC_URL=http://localhost:4000

# Optional catalogue path templates for chatbot pathHint (FE may remap)
# PUBLIC_PATH_INDUSTRY=/catalogue/industries/{slug}
# PUBLIC_PATH_COMPANY=/catalogue/companies/{slug}
# PUBLIC_PATH_PRODUCT=/catalogue/products/{slug}

# WhatsApp handoff (E.164 digits, no +)
WHATSAPP_E164=919007331000

# Advanced chatbot — client-paid usage
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# Password-reset email (optional locally; console logs the link in development)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@psminfinity.com

# Media uploads
# UPLOAD_MAX_BYTES=8388608

# Optional later
# GA4_MEASUREMENT_ID=
